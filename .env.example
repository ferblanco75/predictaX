# Docker Compose overrides for local development.
# Copy to .env and adjust as needed: cp .env.example .env

# Port overrides (useful if the defaults collide with other local services)
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433
REDIS_PORT=6380
GRAFANA_PORT=3005

# Required — docker-compose.yml has no fallback, Grafana refuses to start
# without it (#261: previously defaulted to admin/admin).
GRAFANA_PASSWORD=change-me

# Optional — defaults to predictax_dev if unset.
# POSTGRES_PASSWORD=predictax_dev
